{
  "name": "taqa-knowledge-hub",
  "version": "1.0.0",
  "private": true,
  "description": "RISE (TAQA Knowledge Hub), static frontend prototype. No runtime dependencies; Playwright and http-server are devDependencies used only to build and test the app.",
  "scripts": {
    "test": "playwright test --project=chromium --project=mobile-chrome",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:report": "playwright show-report",
    "serve": "http-server -p 4173 -a 127.0.0.1 -c-1",
    "serve:python": "python3 -m http.server 4173",
    "test:all-engines": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "http-server": "^14.1.1"
  }
}
